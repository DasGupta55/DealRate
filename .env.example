# DealRate (Brand Pricing Tool v2) — environment variables
#
# Copy this file to `.env` for local development. NEVER commit `.env`.
# For production, set the real values in the Netlify dashboard:
# Site settings -> Environment variables.
#
# Legend:
#   [server-only]       used by netlify/functions/api.ts only; never exposed to the browser
#   [build-time client] baked into the client bundle at build time (VITE_*)
#   [public identifier] safe to expose; it is not a secret

# --- Supabase ---
# [public identifier] Supabase project URL.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# [public identifier] Legacy anon public key (starts with eyJ). Used by the client for sign-in.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# [server-only] Service-role key. The API server uses it to enforce per-user ownership.
# Never paste this into the app, the client, or chat. Rejects sb_publishable_/sb_secret_ handling
# in the app is separate; this value itself stays server-side only.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- YouTube (server-only) ---
# [server-only] YouTube Data API v3 key for live channel fetches.
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# --- Brand discovery (server-only) ---
# [server-only] Tavily Search API key for the brand finder web search.
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# --- AI text generation (server-only) ---
# [server-only] Groq API key for pitch generation and brand distillation.
GROQ_API_KEY=YOUR_GROQ_API_KEY

# --- Razorpay (Pro checkout, INR only) ---
# [public identifier] Razorpay Key ID (rzp_test_... for test mode, rzp_live_... for live).
# Returned to the browser by the API so Checkout can open; it is not a secret.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
# [server-only] Razorpay Key Secret. Used server-side for order creation and HMAC signature checks.
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
# [server-only] Razorpay webhook secret. Used server-side to verify X-Razorpay-Signature.
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# --- Public site URL ---
# Public base URL of the deployed site (no trailing slash). Used for redirects and links.
PUBLIC_URL=https://YOUR-SITE.netlify.app

# --- Cron (server-only) ---
# [server-only] Shared secret protecting POST /api/cron/overdue. Must match the
# CRON_SECRET GitHub repo secret used by .github/workflows/overdue-check.yml.
CRON_SECRET=YOUR_CRON_SECRET

# --- Build-time client vars ---
# [build-time client] Base URL for API calls. "" means same-origin on Netlify
# (the /api/* redirect in netlify.toml proxies to the Netlify function).
VITE_API_URL=
# [build-time client] Supabase project URL for the browser client.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# [build-time client] Legacy anon public key for the browser client.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
